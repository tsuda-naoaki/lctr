(set-logic QF_LIA)
(define-fun Unformed () Int 0)
(define-fun Unevaluable () Int 1)
(define-fun Sat () Int 2)
(define-fun Failed () Int 3)
(declare-const f Bool)
(declare-const e Bool)
(declare-const p Bool)
(declare-const c Bool)
(define-fun state () Int (ite (not (and f p)) Unformed (ite (not e) Unevaluable (ite c Sat Failed))))
(assert (not (= state (ite (not e) Unevaluable (ite (not (and f p)) Unformed (ite c Sat Failed))))))
(check-sat)
