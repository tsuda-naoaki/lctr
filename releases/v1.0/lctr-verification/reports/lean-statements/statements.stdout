  (s : E → L → LCTR.CoreTokenGraph.Token → LCTR.SelectedInputEvaluation.State) (ev : E) (l : L)
  (f e c : LCTR.CoreTokenGraph.Token → Bool) (d eps : Fin 9 → ENNReal) (b : Fin 9 → Bool)
  (recurs : LCTR.CoreEvaluation.Recurs.{0} LCTR.CoreTokenGraph.Edge f e c (s ev l))
  (inp : LCTR.CoreContinuumIntegration.InputSat f e (s ev l))
  (matching :
    ∀ (i : Fin 9),
      Eq.{1} (c (LCTR.CoreContinuumIntegration.approxToken i)) (LCTR.CoreContinuumEncoding.paperCondition d eps b i)) :
  (Membership.mem.{u_2, u_2} (LCTR.CoreContinuumSourceBridge.scaleFibre.{u_1, u_2} s ev) l ↔
      Membership.mem.{max u_2 u_1, max u_2 u_1} (LCTR.CoreContinuumSourceBridge.approxDomain.{u_1, u_2} s)
        (Prod.mk.{u_1, u_2} ev l)) ∧
    (Membership.mem.{max u_2 u_1, max u_2 u_1} (LCTR.CoreContinuumSourceBridge.approxDomain.{u_1, u_2} s)
          (Prod.mk.{u_1, u_2} ev l) ↔
        LCTR.CoreContinuumSourceBridge.conditionAll c) ∧
      (LCTR.CoreContinuumSourceBridge.conditionAll c ↔
          ∀ (i : Fin 9), Eq.{1} (c (LCTR.CoreContinuumIntegration.approxToken i)) true) ∧
        ((∀ (i : Fin 9), Eq.{1} (c (LCTR.CoreContinuumIntegration.approxToken i)) true) ↔
            ∀ (i : Fin 9),
              LE.le.{0} (LCTR.CoreContinuumEncoding.paperDefect d b i)
                (LCTR.CoreContinuumEncoding.paperTolerance eps i)) ∧
          ((∀ (i : Fin 9),
                LE.le.{0} (LCTR.CoreContinuumEncoding.paperDefect d b i)
                  (LCTR.CoreContinuumEncoding.paperTolerance eps i)) ↔
              ∀ (i : Fin 9),
                LE.le.{0} 0
                  (LCTR.CoreContinuumBoundary.margin (LCTR.CoreContinuumEncoding.paperTolerance eps i)
                    (LCTR.CoreContinuumEncoding.paperDefect d b i))) ∧
            ((∀ (i : Fin 9),
                  LE.le.{0} 0
                    (LCTR.CoreContinuumBoundary.margin (LCTR.CoreContinuumEncoding.paperTolerance eps i)
                      (LCTR.CoreContinuumEncoding.paperDefect d b i))) ↔
                ∀ (i : Fin 9),
                  Eq.{1}
                    (LCTR.CoreContinuumBoundary.excess (LCTR.CoreContinuumEncoding.paperTolerance eps i)
                      (LCTR.CoreContinuumEncoding.paperDefect d b i))
                    0) ∧
              ((∀ (i : Fin 9),
                  Eq.{1}
                    (LCTR.CoreContinuumBoundary.excess (LCTR.CoreContinuumEncoding.paperTolerance eps i)
                      (LCTR.CoreContinuumEncoding.paperDefect d b i))
                    0) ↔
                Eq.{1}
                  (LCTR.CoreContinuumBoundary.Exceeded.{0} (LCTR.CoreContinuumEncoding.paperDefect d b)
                    (LCTR.CoreContinuumEncoding.paperTolerance eps))
                  EmptyCollection.emptyCollection.{0})
