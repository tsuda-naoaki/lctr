              (f.raw.order j) (LCTR.CoreNativeDifferentialSynthesis.regular b law f h rho j) (f.relation rho j)) ∧
          ∀ (rho sigma : LCTR.CoreNativeDifferentialFamily.Rep (LCTR.CoreLawDifferentialBundle.context b)),
            LCTR.CoreNativeDifferentialFamily.TimeCondition (LCTR.CoreLawDifferentialBundle.context b) law f rho sigma
