  (b : LCTR.CoreLawDifferentialBundle.Basis C D B U L J V W P N Arr) (law : LCTR.CoreLawDifferentialBundle.LawData b)
  (f : LCTR.CoreNativeDifferentialFamily.Family (LCTR.CoreLawDifferentialBundle.context b) law)
  (h : LCTR.CoreNativeDifferentialSynthesis.Operative b law f) :
  (∀ (rho : LCTR.CoreNativeDifferentialFamily.Rep (LCTR.CoreLawDifferentialBundle.context b)),
      ExistsUnique.{1} fun x =>
        LCTR.CoreThreeLayerSynthesis.TransportedSpec b law rho x ∧ LCTR.LawFamilyTransport.AllConditions x.2) ∧
    (∀ (rho : LCTR.CoreNativeDifferentialFamily.Rep (LCTR.CoreLawDifferentialBundle.context b)) (j : ↑f.raw.selected),
        Nonempty.{1}
          (LCTR.CoreNativeAtlasConditions.Regular
            (LCTR.CoreNativeDifferentialFamily.atlas (LCTR.CoreLawDifferentialBundle.context b) law f.raw rho j)
            (f.raw.order j))) ∧
      (∀ (rho : LCTR.CoreNativeDifferentialFamily.Rep (LCTR.CoreLawDifferentialBundle.context b)) (j : ↑f.raw.selected)
          (i : LCTR.CoreLocalCharts.Index (f.raw.timeIndex rho j) (f.raw.valIndex j))
          (theta :
            ↑(LCTR.CoreLocalCharts.NumericDomain
                (LCTR.CoreNativeDifferentialFamily.atlas (LCTR.CoreLawDifferentialBundle.context b) law f.raw rho j)
                i)),
