(set-logic QF_DT)
(declare-datatypes ((State 0)) (((Unformed) (Unevaluable) (Sat) (Failed))))
(declare-const f Bool)
(declare-const e Bool)
(declare-const p Bool)
(declare-const c Bool)
(define-fun state () State (ite (not (and f p)) Unformed (ite (not e) Unevaluable (ite c Sat Failed))))
(assert (not (= (= state Unformed) (not (and f p)))))
(check-sat)
