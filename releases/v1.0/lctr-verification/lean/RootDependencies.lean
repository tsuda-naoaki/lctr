  for name in roots do
    let some info := env.find? name | throwError "Missing published root: {name}"
    let typeDeps := info.type.getUsedConstants.qsort Name.lt
    let proofDeps := match info.value? (allowOpaque := true) with
      | some value => value.getUsedConstants.qsort Name.lt
      | none => #[]
    let axioms ← collectAxioms name
    let names (xs : Array Name) := Json.arr (xs.map fun n => toJson n.toString)
    let row := Json.mkObj [
      ("root",toJson name.toString),
      ("type_dependencies",names typeDeps),
      ("value_dependencies",names proofDeps),
      ("transitive_axioms",names axioms),
      ("has_native_value",toJson (info.hasValue (allowOpaque := true))),
      ("is_axiom",toJson info.isAxiom)]
    liftIO <| IO.println row.compress
